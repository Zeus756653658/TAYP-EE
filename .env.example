# =========================================================
# TAYP EE Cloud POS — Example Environment Template
# Copy this file to .env and fill in your real credentials.
# =========================================================

# --- Server Configuration ---
HOST=0.0.0.0
PORT=8080
APP_NAME=TAYP EE — Cloud POS & Business Suite
APP_VERSION=0.1.0 BETA

# --- Supabase Cloud Database ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_or_anon_key

# --- Primary Admin Login (Username = Verified Gmail) ---
ADMIN_USERNAME=youradmin@gmail.com
ADMIN_PASSWORD=your_strong_password
ADMIN_NAME=Store Admin

# --- Gmail OTP Login Verification (SMTP) ---
AUTH_ENABLED=true
AUTH_SECRET_KEY=replace_with_random_64_hex_secret_key
SMTP_EMAIL=yourstore@gmail.com
SMTP_APP_PASSWORD=your_16_char_google_app_password
OTP_EXPIRY_MINUTES=5
SESSION_HOURS=24

# --- Daily Scheduled Maintenance (5:00 PM) ---
MAINTENANCE_HOUR=17
MAINTENANCE_MINUTE=0
MAINTENANCE_DURATION_MINUTES=5
MAINTENANCE_WARNING_MINUTES=15
EMERGENCY_BYPASS_PIN=1234
